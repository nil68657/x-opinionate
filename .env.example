# Required for nuanced sentiment, stance detection, and theme labelling.
ANTHROPIC_API_KEY=

# Default Claude model. Override to claude-opus-4-5 for higher quality, or
# claude-haiku-4-5 for cheaper batch runs.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: if set, the "Live X API" tweet source is enabled in the UI.
# Get one from https://developer.x.com/.
X_BEARER_TOKEN=
