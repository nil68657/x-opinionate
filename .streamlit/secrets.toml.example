# Local-development copy of the secrets you'll paste into Streamlit Community
# Cloud (App settings → Secrets). Copy this to `.streamlit/secrets.toml` for
# local runs (gitignored), or paste the same TOML into the Cloud UI for prod.
#
# Streamlit exposes these as both `st.secrets["KEY"]` AND as environment
# variables, so the existing `os.getenv("ANTHROPIC_API_KEY")` lookup in
# `src/config.py` keeps working in both environments.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional. Defaults to claude-sonnet-4-5. Try claude-opus-4-5 for top
# quality or claude-haiku-4-5 for cheaper batch runs.
ANTHROPIC_MODEL = "claude-sonnet-4-5"

# Optional. If set, the "Live X API" tweet source appears in the dashboards.
X_BEARER_TOKEN = ""
